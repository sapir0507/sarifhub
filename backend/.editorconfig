# Code style for the backend. Enforced in the build (EnforceCodeStyleInBuild) and by `dotnet format`.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,xml,props,targets,csproj,slnx,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Language preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
dotnet_style_readonly_field = true:warning
csharp_style_prefer_primary_constructors = false:none
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Naming: private fields are _camelCase
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.private_static_readonly.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly.style = pascal
dotnet_naming_rule.private_static_readonly.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.private_consts.symbols = private_consts
dotnet_naming_rule.private_consts.style = pascal
dotnet_naming_rule.private_consts.severity = warning
dotnet_naming_symbols.private_consts.applicable_kinds = field
dotnet_naming_symbols.private_consts.required_modifiers = const
# Order matters: the more specific rules above must win over the generic private field rule.
dotnet_naming_rule.private_consts.priority = 1
dotnet_naming_rule.private_static_readonly.priority = 2
dotnet_naming_rule.private_fields.priority = 3

# Analyzer adjustments (each with a reason)
# CA1848: LoggerMessage delegates matter on hot paths; the few log calls here are not hot.
dotnet_diagnostic.CA1848.severity = suggestion
# CA1515: public types in an application (not a library) are intentional: projects reference each other.
dotnet_diagnostic.CA1515.severity = none

[**/Migrations/*.cs]
# Generated by `dotnet ef migrations add`; reviewed, not hand-edited.
generated_code = true
