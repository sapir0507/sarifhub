<?xml version="1.0" encoding="utf-8"?>
<!--
  One explicit package source, mapped for every package ID.
  Clearing inherited sources and using source mapping prevents dependency confusion:
  a package can only ever be restored from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
